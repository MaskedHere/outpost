generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Singleton row (always id "default") for panel-wide settings that aren't tied to any one server.
model Settings {
  id               String @id @default("default")
  // Pre-fills the playit.gg secret key field when enabling public access on a server, so it only
  // has to be pasted in once instead of per-server.
  defaultPlayitKey String?
  // Seeds the memory slider's starting value in the "New server" wizard.
  defaultMemoryMb  Int    @default(2048)
  // Whether new servers reuse the shared per-game content cache instead of re-downloading the whole
  // game from Steam every time.
  useGameCache     Boolean @default(true)
}

model GameServer {
  id            String    @id @default(uuid())
  name          String
  game          String    @default("minecraft")
  variant       String // per-game server flavor: vanilla | paper | fabric | ... for minecraft, "default" for most others
  version       String
  containerId   String? // docker container id once created
  containerName String    @unique
  gamePort      Int
  rconPort      Int? // host-mapped RCON port, null when this game has no RCON console
  rconPassword  String? // null when this game has no RCON console
  memoryMb      Int       @default(2048)
  dataPath      String // host path bind-mounted into the container
  packId        String?
  pack          Pack?     @relation(fields: [packId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  backups       Backup[]
  plugins       ServerPlugin[]
  sightings     PlayerSighting[]

  // Everything else buildContainerSpec() needs to faithfully recreate this exact container later
  // (e.g. when memory changes)
  motd                 String?
  workshopItemIds       String? // JSON-encoded string[]
  modIds                String? // JSON-encoded string[]
  // Extra per-game server behavior settings (Minecraft: allow-flight, pvp, difficulty, etc.)
  extraSettings          String?

  // Public access via a playit.gg tunnel sidecar.
  tunnelContainerId String?
  tunnelSecretKey   String?

  // Alternative public access via bore (github.com/ekzhang/bore) and its free bore.pub relay.
  boreContainerId String?
  borePort        Int?
}

model Pack {
  id        String     @id @default(uuid())
  name      String
  mcVersion String
  loader    String // fabric | forge | neoforge | quilt
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// Where this pack came from, when it was imported from a Modrinth project.
  modrinthProjectId     String?
  modrinthVersionId     String?
  /// Human-readable version string ("1.2.3"), stored so the UI can show current vs. latest without
  /// another Modrinth request.
  modrinthVersionNumber String?

  items     PackItem[]
  servers   GameServer[]
}

/// A reusable, named list of Steam Workshop items.
model WorkshopPack {
  id        String             @id @default(uuid())
  name      String
  /// Which game this pack targets.
  game      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  items     WorkshopPackItem[]
}

model WorkshopPackItem {
  id     String       @id @default(uuid())
  packId String
  pack   WorkshopPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  workshopItemId String
  title          String
  /// The mod's own internal id, which Project Zomboid needs in addition to the Workshop id in order
  /// to enable it.
  modId          String?
  previewUrl     String?
  createdAt      DateTime     @default(now())

  @@index([packId])
}

model PackItem {
  id     String @id @default(uuid())
  packId String
  pack   Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)

  // "modrinth" items install via itzg's MODRINTH_PROJECTS (auto-updatable, no local storage).
  // "local" items are jars Outpost has the bytes for but couldn't identify on Modrinth;
  // localFilePath (relative to config.packsDir) points at the stored jar, which serverService
  // copies into the mods folder on deploy.
  source        String  @default("modrinth")
  projectId     String? // modrinth project id
  projectSlug   String?
  projectName   String
  versionId     String? // modrinth version id
  versionNumber String?
  localFilePath String?
  // Mod artwork for the pack listing.
  iconUrl       String?
  filename      String
  downloadUrl   String?
  sha1          String
  sha512        String?
  fileSizeBytes Int      @default(0)
  isDependency  Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([packId, filename])
}

model Backup {
  id        String     @id @default(uuid())
  serverId  String
  server    GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  filename  String
  sizeBytes Int
  createdAt DateTime   @default(now())
}

// A Minecraft (Paper) server's installed plugins.
model ServerPlugin {
  id            String     @id @default(uuid())
  serverId      String
  server        GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  projectId     String
  projectSlug   String
  projectName   String
  versionId     String
  versionNumber String
  filename      String
  downloadUrl   String
  sha1          String
  sha512        String
  fileSizeBytes Int        @default(0)
  createdAt     DateTime   @default(now())

  @@unique([serverId, projectId])
}

// A running record of every player RCON has ever reported connected to this server.
model PlayerSighting {
  id          String     @id @default(uuid())
  serverId    String
  server      GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  playerId    String // the RCON-native id: username for Minecraft/Factorio/Zomboid, SteamID for Source engine
  playerName  String
  firstSeenAt DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())

  @@unique([serverId, playerId])
}
