# Copy to .env for local development. On ZimaOS these are set via docker-compose.yml instead.

DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3000

# Where server/backup/config data lives. Defaults to ../../.data (repo-root .data/) if unset.
# On a real ZimaOS install this is bind-mounted to /DATA/AppData/outpost.
# DATA_DIR=../../.data

# Only needed on Linux hosts where the socket path differs from the default.
# DOCKER_SOCKET=/var/run/docker.sock
